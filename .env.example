# Скопируй этот файл в `.env` и впиши свой ключ:
#   cp .env.example .env
#
# mindgraph ищет ключи в окружении или в `.env` рядом с инструментом.
# Минимум нужен один провайдер; без ключа инструмент работает как --no-llm
# (только статический анализ, без смысловой группировки).

# DeepSeek (OpenAI-совместимый API): https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-ваш-ключ

# Anthropic (опционально): https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-ваш-ключ
